{
  "name": "offfline-mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "build:apk": "bash scripts/build-apk.sh --release",
    "build:apk:debug": "bash scripts/build-apk.sh --debug",
    "build:aab": "cd android && ./gradlew bundleRelease",
    "build:ios": "bash scripts/build-ios.sh --sim",
    "build:ios:archive": "bash scripts/build-ios.sh --archive",
    "build:all": "bash scripts/build-all.sh",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "axios": "^1.7.2",
    "lucide-react-native": "^0.395.0",
    "react": "18.2.0",
    "react-native": "0.74.2",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-haptic-feedback": "^2.2.0",
    "react-native-keychain": "^8.2.0",
    "react-native-safe-area-context": "^4.10.1",
    "react-native-screens": "^3.31.1",
    "react-native-svg": "^15.2.0",
    "react-native-vision-camera": "^4.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/runtime": "^7.24.0",
    "@react-native/babel-preset": "0.74.83",
    "@react-native/metro-config": "0.74.83",
    "@react-native/typescript-config": "0.74.83",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.2.79",
    "typescript": "5.0.4"
  },
  "engines": {
    "node": ">=18"
  }
}
